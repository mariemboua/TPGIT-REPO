hpipeline {
    agent any
    tools {
        jdk 'JDK21'
    }
    stages {
        stage('Checkout code')
        {
            steps {
                git branch: 'main', url:'https://github.com/mariemboua/TPGIT-REPO.git'
            }
        }
        stage('Compile code')
        {
            steps {
                sh 'cd src && javac application/Test.java'
            }
        }
        stage('Execute code')
        {
            steps {
                sh 'cd src && java application/Test'
            }
        }
        stage('display message helloooo')
        {
            steps {
                echo 'Hello from github'
            }
        }
        stage('display message bye')
        {
            steps {
                echo 'bye from github'
            }
        }
    }
}
